# Spotify Developer Dashboard (https://developer.spotify.com/dashboard) で作ったアプリの値
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# node scripts/get-refresh-token.mjs で取得。
# --source popular / artist だけ使うなら不要(空のままでよい)。top / saved-* / playlist には必要。
SPOTIFY_REFRESH_TOKEN=
# 1 か月あたりの曲数(省略時 20)
# TRACK_LIMIT=20
